    "%@ places windows slightly above the absolute center,\nwhich can be found more ergonomic." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ places windows slightly above the absolute center,\nwhich can be found more ergonomic."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@将窗口放置在稍高于屏幕中心的位置，使其更加人性化。"
          }
        }
      }
    },
